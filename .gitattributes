# LF everywhere. core.autocrlf is true in Git for Windows' system config, and a
# CRLF workflow file reaches the Linux runner's shell as a trailing carriage
# return on every command. Windows PowerShell 5.1 reads an LF pause.ps1 fine
# (the tests run it so).
*.py    text eol=lf
*.ps1   text eol=lf
*.md    text eol=lf
*.toml  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.txt   text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf
LICENSE        text eol=lf
